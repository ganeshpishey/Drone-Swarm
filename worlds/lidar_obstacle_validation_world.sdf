<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- Lightweight SITL scene for isolating PX4 sensor/estimator and LiDAR
       guarded-motion behavior from the full disaster world's render/physics
       load. The launcher stages this file under earthquake_landslide_world. -->
  <world name="earthquake_landslide_world">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <physics name="lidar_validation_physics" type="ode">
      <!-- Match PX4 X500's 250 Hz IMU update and lockstep cadence. A slower
           physics step can starve PX4's primary accelerometer in SITL. -->
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>27.9881</latitude_deg>
      <longitude_deg>86.9250</longitude_deg>
      <elevation>1450</elevation>
    </spherical_coordinates>
    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.4 0.2 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>1</constant>
        <linear>0</linear>
        <quadratic>0</quadratic>
      </attenuation>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.48 0.45 1</ambient>
            <diffuse>0.45 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Static, unmapped test obstacle: east of Fireman's origin spawn. -->
    <model name="fireman_detour_test_obstacle">
      <static>true</static>
      <pose>1.0 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.0 3.0</size></box></geometry>
          <material>
            <ambient>0.8 0.15 0.1 1</ambient>
            <diffuse>0.8 0.15 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
