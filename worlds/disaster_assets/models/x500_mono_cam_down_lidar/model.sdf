<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_mono_cam_down_lidar">
    <self_collide>false</self_collide>
    <include merge="true">
      <uri>x500</uri>
    </include>
    <include merge="true">
      <uri>model://mono_cam</uri>
      <pose>0 0 0.10 0 1.5707 0</pose>
      <name>mono_cam</name>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 0 0 1.5707 0</pose>
    </joint>

    <!-- Sensor-only add-on; keep the PX4 X500 base, motors and propellers. -->
    <link name="lidar_link">
      <pose relative_to="base_link">0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scout/lidar/points</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <update_rate>5</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-3.141593</min_angle>
              <max_angle>3.141593</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.20</min>
            <max>25.0</max>
            <resolution>0.02</resolution>
          </range>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="LidarJoint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
  </model>
</sdf>
